{
  "expo": {
    "name": "PetMania",
    "slug": "petmania",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-1024.png",
    "scheme": "petmania",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleId": "com.garv_thakral.petmania",
      "icon": {
        "path": "./assets/images/icon-1024.png"
      },
      "bundleIdentifier": "com.garv-thakral.petmania"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.garv_thakral.petmania"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png",
      "bundler": "metro"
    },
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "imageWidth": 250,
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 250,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-web-browser",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "garv_thakral",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "61a8e382-57eb-4216-bd23-f4b9b87be815"
      }
    }
  }
}
